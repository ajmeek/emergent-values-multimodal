f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435**: \u0426\u0435\u043d\u0442\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u044c \u0448\u0442\u0430\u0442\u0430 \u0418\u043d\u0434\u0438\u0430\u043d\u0430, \u0421\u0428\u0410\n- **\u041d\u0430\u0441\u0435\u043b\u0435\u043d\u0438\u0435**: \u041e\u043a\u043e\u043b\u043e 850 000 \u0447\u0435\u043b\u043e\u0432\u0435\u043a (\u043c\u0435\u0442\u0440\u043e\u043f\u043e\u043b\u0438\u0442\u0435\u043d\u0441\u043a\u0438\u0439 \u0440\u0435\u0433\u0438\u043e\u043d)\n- **\u0418\u0441\u0442\u043e\u0440\u0438\u044f**: \u041e\u0441\u043d\u043e\u0432\u0430\u043d \u0432 1821 \u0433\u043e\u0434\u0443\n- **\u042d\u043a\u043e\u043d\u043e\u043c\u0438\u043a\u0430**: \u0410\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u0438\u0432\u043d\u044b\u0439 \u0446\u0435\u043d\u0442\u0440, \u0430\u043a\u0442\u0438\u0432\u043d\u0430\u044f \u043f\u0440\u043e\u043c\u044b\u0448\u043b\u0435\u043d\u043d\u043e\u0441\u0442\u044c \u0438 \u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435\n- **\u041f\u043e\u043b\u0438\u0442\u0438\u043a\u0430**: \u0421\u0442\u043e\u043b\u0438\u0446\u0430 \u0448\u0442\u0430\u0442\u0430 \u0418\u043d\u0434\u0438\u0430\u043d\u0430\n- **\u041a\u0443\u043b\u044c\u0442\u0443\u0440\u0430**: \u0411\u043e\u0433\u0430\u0442\u0430\u044f \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u0430\u044f \u0441\u0446\u0435\u043d\u0430, \u043c\u043d\u043e\u0433\u043e\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u0435 \u043c\u0443\u0437\u0435\u0438 \u0438 \u0442\u0435\u0430\u0442\u0440\u044b\n- **\u041e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u043d\u0438\u0435**: \u041a\u0440\u0443\u043f\u043d\u044b\u0435 \u0443\u043d\u0438\u0432\u0435\u0440\u0441\u0438\u0442\u0435\u0442\u044b, \u0432\u043a\u043b\u044e\u0447\u0430\u044f \u0418\u043d\u0434\u0438\u0430\u043d\u0443-\u0423\u044d\u0441\u0442 \u041b\u0435\u0439\u043a \u0438 \u0418\u043d\u0434\u0438\u0430\u043d\u0443-\u041f\u043e\u0439\u043d\u0442\n- **\u